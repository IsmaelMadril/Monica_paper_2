# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Local configuration and credentials
.env
.env.*
!.env.example

# macOS and editor temporary files
.DS_Store
~$*
*.swp
*.swo

# Source datasets and immutable local snapshots (manifest is tracked)
Data_base/
Results/*.spv
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# Regenerated analysis products
outputs/tables/*
!outputs/tables/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
